{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build main (all .cpp files)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-Wall", "-Wextra", "-Wpedantic", "-Wshadow",
                "-Wconversion", "-Wsign-conversion",
                "-g3", "-O0",
                "main.cpp", "Knapsack.cpp", "MST.cpp", "Dijkstra.cpp",
                "-o", "delivery.exe"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build tests (all .cpp files)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-Wall", "-Wextra", "-g3", "-O0",
                "tests.cpp", "Knapsack.cpp", "MST.cpp", "Dijkstra.cpp",
                "-o", "tests.exe"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
